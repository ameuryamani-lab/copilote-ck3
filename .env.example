# CK3 Copilot: copy this file to ".env" (same folder), then paste your key after the = sign.
# Google Gemini key (required): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI key (optional): fallback when Google refuses (no credit left, outage).
OPENAI_API_KEY=

# Optional: answer language, en or fr, until you pick one in the tray menu (default: your Windows language).
# COPILOTE_LANGUE=en
# Optional: your first name, given to the copilot (without it, it talks to "the player").
# COPILOTE_PRENOM=
# Optional: the game's folder, only if Steam is installed somewhere unusual and the copilot says it cannot find the game's Encyclopedia.
# COPILOTE_CK3_DIR=D:\SteamLibrary\steamapps\common\Crusader Kings III
